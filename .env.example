# ── Binance Agent OS — Required ──────────────────────────────
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_MCP_API_KEY=your_agentic_api_key_here
BINANCE_MCP_SECRET=your_agentic_api_secret_here
BINANCE_AGENTIC_ACCOUNT_ID=your_agentic_account_id_here

# ── Binance x402 Payments ─────────────────────────────────────
BINANCE_X402_ENDPOINT=https://agent.binance.com/x402
BINANCE_X402_API_KEY=your_x402_key_here
X402_PREMIUM_DATA_COST_USDC=0.001

# ── Google Gemini (GRATUIT via AI Studio) ────────────────────
# Obtenir une clé GRATUITE sur : https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Risk Limits (adjust as needed) ───────────────────────────
RISK_MAX_POSITION_USDC=50
RISK_MAX_DRAWDOWN_PCT=5
RISK_MAX_TRADES_PER_HOUR=10
RISK_APPROVAL_THRESHOLD=20
RISK_MIN_CONFIDENCE=65
RISK_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
RISK_MAX_OPEN_POSITIONS=3
RISK_STOP_LOSS_PCT=2
RISK_TAKE_PROFIT_PCT=4

# ── Scout Agent ───────────────────────────────────────────────
SCOUT_POLL_INTERVAL=30

# ── Paths ─────────────────────────────────────────────────────
AUDIT_LOG_PATH=logs/audit_trail.json
